# Shared API documentation defaults. Set PROJECT_NAME, PROJECT_BRIEF and INPUT in the repository Doxyfile.

OUTPUT_DIRECTORY       = docs/api
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html

# The reference covers the public API. The detail/ directories are unstable,
# and tests and examples are outside the API. The consumer sets INPUT to match
# its module layout.
FILE_PATTERNS          = *.h *.hh *.hpp *.hxx *.ipp *.tpp *.inl
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */detail/*

# The reference should show entities with a stated contract. Undocumented
# entities are omitted, and WARN_IF_UNDOCUMENTED reports them.
#
# HIDE_UNDOC_MEMBERS and HIDE_UNDOC_CLASSES must stay NO. The flags that hide an
# entity from the reference also hide its warning. With those flags YES, the
# api-docs job skips undocumented entities. A negative control verifies
# that undocumented public entities produce warnings.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = YES

# Expand defaults for public APIs whose declarations use preprocessor macros.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES

# Include graphs are disabled: they are not worth requiring Graphviz wherever
# the reference is built.
HAVE_DOT               = NO

JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES
SORT_MEMBER_DOCS       = NO
GENERATE_TREEVIEW      = YES
